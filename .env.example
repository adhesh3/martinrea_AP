# ─── Application ────────────────────────────────────────────────
# Set to 'production' to deploy with real Epicor adapters. Any other
# value (development / test / staging) loads `MockEpicorModule` at the
# AppModule level so demos and CI can run without VPN access.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ─── Database (Postgres) ────────────────────────────────────────
# Matches docker-compose.yml. `martinrea_ap` is auto-created by the
# Postgres image on first boot.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=martinrea_ap
DB_USER=postgres
DB_PASS=postgres

# ─── SAT (CFDI verification) ────────────────────────────────────
# Defaults match SAT's public Consulta CFDI SOAP endpoint. Swap
# SAT_ENDPOINT_URL to an authorised PAC URL if SAT direct access is
# ever revoked. SAT_RETRY_DELAYS_MS is a comma-separated list — its
# length determines max attempts (entries + 1 immediate attempt).
SAT_ENDPOINT_URL=https://consultaqr.facturaelectronica.sat.gob.mx/ConsultaCFDIService.svc
SAT_TIMEOUT_MS=8000
SAT_RETRY_DELAYS_MS=1000,2000,4000

# ─── Azure Blob Storage (CFDI XML payloads) ─────────────────────
# Pending Roshni for the real Azure Blob client. `readFromBlob(...)`
# currently returns a hardcoded sample CFDI so the rest of the
# validation pipeline can be exercised end-to-end.
AZURE_BLOB_CONNECTION_STRING=PLACEHOLDER
AZURE_BLOB_CONTAINER_CFDI=invoices-cfdi-raw

# ─── Alerting (sync failures) ───────────────────────────────────
# Either secret left as PLACEHOLDER (or unset) degrades to a console
# `[ALERT MOCK]` line — handy for dev / staging. Both can be enabled
# independently; one failing never blocks the other.
SLACK_WEBHOOK_URL=PLACEHOLDER
DATADOG_API_KEY=PLACEHOLDER

# ─── Sync orchestrator ──────────────────────────────────────────
MAX_CONCURRENT_EPICOR_CONNECTIONS=8

# ─── Per-instance Epicor credentials (1..44) ────────────────────
# For each instance declared in src/integrations/config/epicor-
# instances.config.ts, set five vars. Region defaults: US plants use
# ODBC on port 1433, Mexico + Canada plants use SFTP on port 22.
#
#   EPICOR_INSTANCE_<N>_HOST
#   EPICOR_INSTANCE_<N>_PORT
#   EPICOR_INSTANCE_<N>_USER
#   EPICOR_INSTANCE_<N>_PASSWORD
#   EPICOR_INSTANCE_<N>_DATABASE
#
# Example (US plant 1):
# EPICOR_INSTANCE_1_HOST=epicor-hopkinsville-1.martinrea.local
# EPICOR_INSTANCE_1_PORT=1433
# EPICOR_INSTANCE_1_USER=mr_ap_svc
# EPICOR_INSTANCE_1_PASSWORD=__from_secrets_manager__
# EPICOR_INSTANCE_1_DATABASE=EpicorERP_HOPK1
#
# Alternative: a single EPICOR_CREDENTIALS_JSON env var holding the
# whole array can be wired up once Martinrea decides on the
# secrets-manager format. Keep this section in sync with that choice.
EPICOR_CREDENTIALS_JSON=PLACEHOLDER
